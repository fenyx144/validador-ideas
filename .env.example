# Copia este archivo como .env.local y completa tu clave.
# Clave gratuita en https://console.groq.com/keys  (NUNCA la subas a GitHub)
GROQ_API_KEY=

# Opcional: modelo de Groq (por defecto llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Opcional: máximo de análisis por minuto por IP (por defecto 5)
# RATE_LIMIT_POR_MINUTO=5
